// https://vitejs.dev/config/
VITE_GITHUB_USERNAME=TenSon-Jian
# 可选：填入 Personal Access Token 可提升 GitHub API 速率限制（切勿提交真实 token）
VITE_GITHUB_TOKEN=
# 取数策略：
#   auto（默认）= 有构建快照就用快照，完全不发 API 请求
#   live        = 总是实时请求 GitHub，失败后退回快照 / 缓存 / 内置数据
#   snapshot    = 只用快照，零请求（连 live 的降级尝试都不做）
VITE_GITHUB_MODE=auto
VITE_SITE_URL=https://ajian.dev
